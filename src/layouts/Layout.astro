---
interface Props {
  title: string;
  description: string;
  schemaJson?: object | object[];
  keywords?: string;
}

const { title, description, schemaJson, keywords } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
import "../styles/global.css";
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}

    <!-- Naver Search Advisor 인증 (한국 SEO 필수) -->
    <meta name="naver-site-verification" content="84b01b1cd554d55c926c692f9549456aac58ea20" />

    <!-- Google Search Console 인증 (검색 노출 최적화) -->
    <meta name="google-site-verification" content="REPLACE_WITH_YOUR_VERIFICATION_CODE" />

    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:image" content="https://lucksajueun.com/og-image.png" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Google AdSense - publisher ID (KYC 심사 진행 중, 코드 선삽입으로 심사 가속) -->
    <script is:inline>
      const ADSENSE_ID = "ca-pub-3100951284055562";
      if (ADSENSE_ID && ADSENSE_ID.startsWith("ca-pub-")) {
        const s = document.createElement("script");
        s.async = true;
        s.src = `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_ID}`;
        s.crossOrigin = "anonymous";
        document.head.appendChild(s);
      }
    </script>

    <!-- JSON-LD 구조화 데이터 (Google rich snippets) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://lucksajueun.com/#website",
          "name": "오늘의 운세 - lucksajueun.com",
          "url": "https://lucksajueun.com",
          "description": "만세력 기반 무료 운세·사주팔자·음력변환·로또번호 생성·연봉실수령액 계산",
          "inLanguage": "ko-KR",
          "potentialAction": {
            "@type": "SearchAction",
            "target": "https://lucksajueun.com/?q={search_term_string}",
            "query-input": "required name=search_term_string"
          }
        },
        {
          "@type": "Organization",
          "@id": "https://lucksajueun.com/#organization",
          "name": "오늘의 운세",
          "url": "https://lucksajueun.com",
          "logo": {
            "@type": "ImageObject",
            "url": "https://lucksajueun.com/favicon.svg"
          },
          "email": "contact@lucksajueun.com",
          "sameAs": []
        },
        {
          "@type": "WebApplication",
          "name": "운세·사주 계산기",
          "url": "https://lucksajueun.com",
          "applicationCategory": "LifestyleApplication",
          "operatingSystem": "Any",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "KRW"
          },
          "inLanguage": "ko-KR"
        }
      ]
    })} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", "Pretendard Variable", Pretendard, Roboto, "Noto Sans KR", "Segoe UI", "Malgun Gothic", sans-serif;
        font-size: 16px;
        line-height: 1.6;
        color: #1a1a1a;
        background: #f5f5f7;
      }
      a { color: inherit; }
      nav.site-nav {
        background: #fff;
        border-bottom: 1px solid #e5e5e5;
        padding: 14px 16px;
      }
      nav.site-nav .inner {
        max-width: 880px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      nav.site-nav .logo {
        font-weight: 800;
        font-size: 18px;
        text-decoration: none;
        color: #1a1a1a;
      }
      nav.site-nav ul {
        display: flex;
        gap: 14px;
        list-style: none;
        margin: 0;
        padding: 0;
        font-size: 13px;
        flex-wrap: wrap;
      }
      nav.site-nav a { text-decoration: none; color: #555; }
      nav.site-nav a:hover { color: #8b5cf6; }
      footer.site-footer {
        text-align: center;
        padding: 32px 16px;
        color: #888;
        font-size: 13px;
      }
      footer.site-footer a { color: #888; text-decoration: underline; }
    </style>

    {schemaJson && (
      <script type="application/ld+json" set:html={JSON.stringify(schemaJson)} />
    )}
  </head>
  <body>
    <nav class="site-nav">
      <div class="inner">
        <a class="logo" href="/">🍀 오늘의 운세</a>
        <ul>
          <li><a href="/saju/">사주팔자</a></li>
          <li><a href="/lunar-calendar/">음력변환</a></li>
          <li><a href="/zodiac/">띠별운세</a></li>
          <li><a href="/lotto/">로또</a></li>
          <li><a href="/salary/">연봉계산</a></li>
          <li><a href="/about/">소개</a></li>
        </ul>
      </div>
    </nav>
    <slot />
    <footer class="site-footer">
      <p>© 2026 오늘의 운세 · 만세력 데이터 기반 무료 운세 서비스</p>
      <p>
        <a href="/about/">이용 안내</a> ·
        <a href="/methodology/">운세 방법론</a> ·
        <a href="/sources/">출처 및 참고 자료</a> ·
        <a href="/editorial-policy/">편집 정책</a> ·
        <a href="/privacy/">개인정보처리방침</a> ·
        <a href="/terms/">이용약관</a> ·
        <a href="/contact/">문의하기</a>
        · 본 서비스는 의료·법률·재정 상담이 아닙니다.
      </p>
    </footer>
  </body>
</html>