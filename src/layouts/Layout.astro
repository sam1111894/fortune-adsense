---
interface Props {
  title: string;
  description: string;
  schemaJson?: object | object[];
  keywords?: string;
}

const { title, description, schemaJson, keywords } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
import "../styles/global.css";
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}

    <!-- Naver Search Advisor 인증 (한국 SEO 필수) -->
    <meta name="naver-site-verification" content="84b01b1cd554d55c926c692f9549456aac58ea20" />

    <!-- Google Search Console 인증 (검색 노출 최적화) -->
    <meta name="google-site-verification" content="REPLACE_WITH_YOUR_VERIFICATION_CODE" />

    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:image" content="https://lucksajueun.com/og-image.png" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Google AdSense - publisher ID (KYC 심사 진행 중, 코드 선삽입으로 심사 가속) -->
    <script is:inline>
      const ADSENSE_ID = "ca-pub-3100951284055562";
      if (ADSENSE_ID && ADSENSE_ID.startsWith("ca-pub-")) {
        const s = document.createElement("script");
        s.async = true;
        s.src = `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_ID}`;
        s.crossOrigin = "anonymous";
        document.head.appendChild(s);
      }
    </script>

    <!-- JSON-LD 구조화 데이터 (Google rich snippets) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://lucksajueun.com/#website",
          "name": "오늘의 운세 - lucksajueun.com",
          "url": "https://lucksajueun.com",
          "description": "만세력 기반 무료 운세·사주팔자·음력변환·로또번호 생성·연봉실수령액 계산",
          "inLanguage": "ko-KR",
          "potentialAction": {
            "@type": "SearchAction",
            "target": "https://lucksajueun.com/?q={search_term_string}",
            "query-input": "required name=search_term_string"
          }
        },
        {
          "@type": "Organization",
          "@id": "https://lucksajueun.com/#organization",
          "name": "오늘의 운세",
          "url": "https://lucksajueun.com",
          "logo": {
            "@type": "ImageObject",
            "url": "https://lucksajueun.com/favicon.svg"
          },
          "email": "contact@lucksajueun.com",
          "sameAs": []
        },
        {
          "@type": "WebApplication",
          "name": "운세·사주 계산기",
          "url": "https://lucksajueun.com",
          "applicationCategory": "LifestyleApplication",
          "operatingSystem": "Any",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "KRW"
          },
          "inLanguage": "ko-KR"
        }
      ]
    })} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Noto Serif KR만 외부 (display 전용). body는 system font stack — 한글 가독성 손실 없음 -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;600;700&display=swap" />

    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: var(--font-body);
        font-size: var(--fs-sm);
        line-height: var(--lh-body);
        color: var(--color-ink-soft);
        background: var(--color-paper);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      a { color: inherit; text-decoration: none; }
      button { font-family: inherit; }

      h1, h2, h3, h4 {
        font-family: var(--font-display);
        letter-spacing: var(--track-display);
        color: var(--color-ink-deep);
        font-weight: 600;
      }

      /* ----- Editorial site nav ----- */
      nav.site-nav {
        background: var(--color-paper);
        border-bottom: 1px solid var(--color-line-soft);
        padding: var(--s-2, 8px) var(--s-2, 8px) var(--s-1, 4px);
      }
      nav.site-nav .inner {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: var(--s-2, 8px);
      }
      nav.site-nav .logo {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: var(--fs-md);
        text-decoration: none;
        color: var(--color-ink-deep);
        letter-spacing: var(--track-display);
      }
      nav.site-nav ul {
        display: flex;
        gap: var(--s-3, 16px);
        list-style: none;
        margin: 0;
        padding: 0;
        font-family: var(--font-body);
        font-size: 15px;
        font-weight: 500;
        letter-spacing: 0;
        flex-wrap: wrap;
      }
      nav.site-nav a { text-decoration: none; color: var(--color-ink-deep); transition: color 0.15s; padding: var(--s-1, 4px) 0; }
      nav.site-nav a:hover { color: var(--color-wine); }
      nav.site-nav a[aria-current="page"] { color: var(--color-wine); font-weight: 600; }

      /* ----- Editorial site footer ----- */
      footer.site-footer {
        border-top: 2px solid var(--color-ink-deep);
        padding: var(--s-3, 16px) var(--s-2, 8px) var(--s-2, 8px);
        color: var(--color-ink-muted);
        font-size: var(--fs-xs);
        margin-top: var(--s-3, 16px);
      }
      footer.site-footer .inner {
        max-width: 1200px;
        margin: 0 auto;
      }
      footer.site-footer p { margin: 0 0 var(--s-1, 4px); }
      footer.site-footer a { color: var(--color-ink-muted); text-decoration: underline; text-underline-offset: 3px; }
      footer.site-footer a:hover { color: var(--color-wine); }

      @media (max-width: 600px) {
        nav.site-nav .inner { flex-direction: column; align-items: flex-start; gap: var(--s-1, 4px); }
      }
    </style>

    {schemaJson && (
      <script type="application/ld+json" set:html={JSON.stringify(schemaJson)} />
    )}
  </head>
  <body>
    <nav class="site-nav">
      <div class="inner">
        <a class="logo" href="/">🍀 오늘의 운세</a>
        <ul>
          <li><a href="/saju/" aria-current={Astro.url.pathname === '/saju/' || Astro.url.pathname === '/' ? 'page' : undefined}>사주팔자</a></li>
          <li><a href="/zodiac/" aria-current={Astro.url.pathname.startsWith('/zodiac') ? 'page' : undefined}>띠별운세</a></li>
          <li><a href="/salary/" aria-current={Astro.url.pathname.startsWith('/salary') ? 'page' : undefined}>연봉계산</a></li>
          <li><a href="/lotto/" aria-current={Astro.url.pathname.startsWith('/lotto') ? 'page' : undefined}>로또</a></li>
          <li><a href="/lunar-calendar/" aria-current={Astro.url.pathname.startsWith('/lunar-calendar') ? 'page' : undefined}>음력변환</a></li>
          <li><a href="/blog/" aria-current={Astro.url.pathname.startsWith('/blog') ? 'page' : undefined}>블로그</a></li>
          <li><a href="/about/" aria-current={Astro.url.pathname.startsWith('/about') ? 'page' : undefined}>소개</a></li>
        </ul>
      </div>
    </nav>
    <slot />
    <footer class="site-footer">
      <div class="inner">
        <p>© 2026 오늘의 운세 · 만세력 데이터 기반 무료 운세 서비스</p>
        <p>
          <a href="/about/">이용 안내</a> ·
          <a href="/methodology/">운세 방법론</a> ·
          <a href="/blog/">블로그</a> ·
          <a href="/sources/">출처 및 참고 자료</a> ·
          <a href="/editorial-policy/">편집 정책</a> ·
          <a href="/privacy/">개인정보처리방침</a> ·
          <a href="/terms/">이용약관</a> ·
          <a href="/contact/">문의하기</a>
          · 본 서비스는 의료·법률·재정 상담이 아닙니다.
        </p>
      </div>
    </footer>
  </body>
</html>