---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />

    <!-- Google AdSense - 사용자가 발급받은 코드로 교체 예정 -->
    <!-- <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXX" crossorigin="anonymous"></script> -->

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", "Pretendard Variable", Pretendard, Roboto, "Noto Sans KR", "Segoe UI", "Malgun Gothic", sans-serif;
        font-size: 16px;
        line-height: 1.6;
        color: #1a1a1a;
        background: #f5f5f7;
      }
      a { color: inherit; }
      nav.site-nav {
        background: #fff;
        border-bottom: 1px solid #e5e5e5;
        padding: 14px 16px;
      }
      nav.site-nav .inner {
        max-width: 880px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      nav.site-nav .logo {
        font-weight: 800;
        font-size: 18px;
        text-decoration: none;
        color: #1a1a1a;
      }
      nav.site-nav ul {
        display: flex;
        gap: 14px;
        list-style: none;
        margin: 0;
        padding: 0;
        font-size: 13px;
        flex-wrap: wrap;
      }
      nav.site-nav a { text-decoration: none; color: #555; }
      nav.site-nav a:hover { color: #8b5cf6; }
      footer.site-footer {
        text-align: center;
        padding: 32px 16px;
        color: #888;
        font-size: 13px;
      }
      footer.site-footer a { color: #888; text-decoration: underline; }
    </style>
  </head>
  <body>
    <nav class="site-nav">
      <div class="inner">
        <a class="logo" href="/">🍀 오늘의 운세</a>
        <ul>
          <li><a href="/saju">사주팔자</a></li>
          <li><a href="/lunar-calendar">음력변환</a></li>
          <li><a href="/zodiac">띠별운세</a></li>
          <li><a href="/lotto">로또</a></li>
          <li><a href="/salary">연봉계산</a></li>
          <li><a href="/about">소개</a></li>
        </ul>
      </div>
    </nav>
    <slot />
    <footer class="site-footer">
      <p>© 2026 오늘의 운세 · 만세력 데이터 기반 무료 운세 서비스</p>
      <p>
        <a href="/about">이용 안내</a> ·
        <a href="/privacy">개인정보처리방침</a> ·
        <a href="/terms">이용약관</a> ·
        <a href="/contact">문의하기</a>
        · 본 서비스는 의료·법률·재정 상담이 아닙니다.
      </p>
    </footer>
  </body>
</html>