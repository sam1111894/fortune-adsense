<script>
  const HOT_WEIGHTED = [12, 17, 18, 33, 34, 40, 45];
  const COLD = [2, 5, 21, 23, 30, 38];

  function secureRandomInt(max: number): number {
    const arr = new Uint32Array(1);
    crypto.getRandomValues(arr);
    return arr[0] % max;
  }

  function pickRandomLotto(aiMode: boolean): number[] {
    const pool = aiMode
      ? [...Array(45)].map((_, i) => {
          // AI 모드: HOT 번호 가중치 2배
          const weight = HOT_WEIGHTED.includes(i + 1) ? 2 : 1;
          return { num: i + 1, weight };
        })
      : [...Array(45)].map((_, i) => ({ num: i + 1, weight: 1 }));

    const totalWeight = pool.reduce((s, x) => s + x.weight, 0);
    const picked: number[] = [];
    const remaining = [...pool];

    while (picked.length < 6) {
      const r = secureRandomInt(totalWeight);
      let acc = 0;
      let chosen = 0;
      for (let i = 0; i < remaining.length; i++) {
        acc += remaining[i].weight;
        if (r < acc) {
          chosen = i;
          break;
        }
      }
      picked.push(remaining[chosen].num);
      remaining.splice(chosen, 1);
    }

    return picked.sort((a, b) => a - b);
  }

  function renderBalls(numbers: number[], bonus?: number): string {
    const balls = numbers
      .map((n) => {
        const cls = n <= 10 ? "yellow" : n <= 20 ? "blue" : n <= 30 ? "red" : n <= 40 ? "gray" : "green";
        return `<span class="result-ball ${cls}">${n}</span>`;
      })
      .join("");
    const plus = bonus !== undefined ? `<span class="plus">+</span><span class="result-ball bonus">${bonus}</span>` : "";
    return `<div class="balls-row">${balls}${plus}</div>`;
  }

  const btn = document.getElementById("generate-btn") as HTMLButtonElement;
  const resultArea = document.getElementById("result-area") as HTMLDivElement;
  const aiToggle = document.getElementById("ai-mode") as HTMLInputElement;

  btn.addEventListener("click", () => {
    const aiMode = aiToggle.checked;
    btn.disabled = true;
    btn.textContent = "생성 중...";
    resultArea.innerHTML = "";

    try {
      const sets: { main: number[]; bonus: number }[] = [];
      for (let i = 0; i < 5; i++) {
        const main = pickRandomLotto(aiMode);
        let bonus = secureRandomInt(45) + 1;
        while (main.includes(bonus)) bonus = secureRandomInt(45) + 1;
        sets.push({ main, bonus });
      }

      resultArea.innerHTML = sets
        .map(
          (s, i) => `
            <article class="lotto-set">
              <header><span class="set-label">${i + 1}세트</span>${aiMode ? '<span class="ai-badge">AI</span>' : ''}</header>
              ${renderBalls(s.main, s.bonus)}
            </article>
          `,
        )
        .join("");
    } finally {
      btn.disabled = false;
      btn.textContent = "🎲 번호 새로 뽑기 (5세트)";
    }
  });
</script>

