---
/**
 * 12띠 개별 페이지 동적 라우트
 * 빌드 시 12개 HTML 자동 생성 (/zodiac/rat, /zodiac/ox, ...)
 */
import Layout from "../../layouts/Layout.astro";
import AdSenseAd from "../../components/AdSenseAd.astro";
import Disclaimer from "../../components/Disclaimer.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import { ZODIACS } from "../../data/zodiacs";

export async function getStaticPaths() {
  return ZODIACS.map((z) => ({
    params: { slug: z.slug },
    props: { zodiac: z, all: ZODIACS },
  }));
}

const { zodiac, all } = Astro.props;
const currentYear = new Date().getFullYear();

const pageTitle = `${zodiac.name}띠 ${currentYear}년 운세 - 성격, 궁합, 행운의 색까지`;
const pageDesc = `${zodiac.name}띠(${zodiac.hanja}, ${zodiac.element})의 성격 특징·강점·약점, 잘 맞는 궁합·안 맞는 궁합, 행운의 색·숫자·길일까지 정리했습니다. ${currentYear}년 운세 조언도 포함. 다른 11개 띠 정보도 함께 확인하세요.`;
---

<Layout title={pageTitle} description={pageDesc}>
  <main class="container">
    <header class="page-header">
      <p class="eyebrow">12띠 운세 가이드</p>
      <h1>{zodiac.name}띠 - 성격, 궁합, {currentYear}년 운세</h1>
      <p class="subtitle">{zodiac.element} · {zodiac.direction} · {zodiac.month} · {zodiac.directionTime}</p>
    </header>

    <!-- 섹션 1: 한자·오행·방위 기본 정보 -->
    <section class="info-card">
      <h2>{zodiac.name}띠 기본 정보</h2>
      <p>한국·중국 전통 천간지지(天干地支)에서 {zodiac.name}띠는 <strong>{zodiac.hanja}</strong>(지지)로 표기하며, 한자 한 글자로 표현됩니다. {zodiac.month} 출생자가 해당되며, 전통 시간 구분에서 <strong>{zodiac.directionTime}</strong> 사이에 태어난 아이가 {zodiac.name}시(時)에 해당합니다.</p>
      <p>오행은 <strong>{zodiac.element}</strong>에 속합니다. {zodiac.element === "수(水)" ? "물(水)은 유동성·지혜·의지를 상징하며, 북방을 상징합니다." : ""}{zodiac.element === "토(土)" ? "흙(土)은 안정성·신뢰·중심을 상징하며, 중앙을 상징합니다." : ""}{zodiac.element === "목(木)" ? "나무(木)은 성장·인자함·봄을 상징하며, 동방을 상징합니다." : ""}{zodiac.element === "화(火)" ? "불(火)은 열정·활기·여름을 상징하며, 남방을 상징합니다." : ""}{zodiac.element === "금(金)" ? "쇠(金)은 결단력·정의·가을을 상징하며, 서방을 상징합니다." : ""} 전통 명리학에서는 같은 속성의 오행끼리는 서로 강화하고, 다른 오행끼리는 보완 관계가 된다고 봅니다.</p>
    </section>

    <!-- 섹션 2: 역사·문화적 배경 -->
    <section class="info-card">
      <h2>{zodiac.name}띠의 유래와 문화</h2>
      <p>12띠(十二支)는 동아시아 전통 천간지지 체계에서 유래한 12년 주기 동물 기호입니다. 전국 시대(BC 5~3세기) 중국에서 이미 시간·방위를 12지지로 표기하던 기록이 있고, 한漢 시대(BC 2~AD 2세기)에 이르러 해(年) 단위 순환으로 확장되어 생년·띠 개념이 정착됐습니다. 고려 시대에는 도교·풍수지리와 함께 한반도에 전파돼, 궁중·민간 모두에서 출생 시각·방위의 길일(吉日)을 정하는 기준으로 사용됐습니다.</p>
      <p>{zodiac.name}띠는 동아시아 민속에서 오랜 역사를 가진 동물 기호입니다. 문화마다 약간의 차이는 있지만, {zodiac.element} 오행과 {zodiac.direction} 방위를 연결 짓는 전통은 한국·중국·일본·베트남에서 공유됩니다.</p>
    </section>

    <!-- 섹션 3: 성격 (강점·약점) -->
    <section class="info-card">
      <h2>{zodiac.name}띠 성격 - 강점과 약점</h2>
      <p>{zodiac.personality}</p>
      <h3>강점</h3>
      <ul>{zodiac.strengths.map((s) => <li>{s}</li>)}</ul>
      <h3>약점</h3>
      <ul>{zodiac.weaknesses.map((w) => <li>{w}</li>)}</ul>
    </section>

    <!-- 섹션 4: 궁합 -->
    <section class="info-card">
      <h2>{zodiac.name}띠 궁합 - 잘 맞는 띠, 안 맞는 띠</h2>
      <h3>잘 맞는 띠</h3>
      <ul>{zodiac.bestMatch.map((b) => <li><strong>{b.name}띠</strong> - {b.reason}</li>)}</ul>
      <h3>안 맞는 띠</h3>
      <ul>{zodiac.worstMatch.map((w) => <li><strong>{w.name}띠</strong> - {w.reason}</li>)}</ul>
      <p class="related-note">다른 11개 띠의 자세한 성향은 <a href="/zodiac/">12띠 전체 가이드</a>에서 확인해 보세요.</p>
    </section>

    <!-- 섹션 5: 행운의 요소 (연도 자동화) -->
    <section class="info-card">
      <h2>{zodiac.name}띠 행운의 요소</h2>
      <p>전통 명리학에서 {zodiac.name}띠에게 길(吉)한 요소는 — <strong>행운의 색 {zodiac.lucky.color}</strong>, <strong>행운의 숫자 {zodiac.lucky.number}</strong>, <strong>길일 {zodiac.lucky.day}</strong>. 색은 일상 소품·옷차림·인테리어에 활용하면 심리적 안정감을 주고, 숫자는 중요한 결정의 날짜·시간에 참고하면 좋습니다.</p>
      <p>길일(吉日)에 중요한 일정을 잡으면 심리적 자신감과 집중력이 높아진다고 봅니다. 단, 길일은 행운의 한 요소일 뿐 절대적인 기준은 아니므로, 실제 결정은 현실적 조건을 종합해 판단하시기 바랍니다.</p>
    </section>

    <!-- 섹션 6: 올해 운세 조언 + 면책 (연도 자동화) -->
    <section class="info-block advice-block">
      <h2>{zodiac.name}띠 {currentYear}년 운세 조언</h2>
      <p>{zodiac.advice}</p>
      <p class="disclaimer-line"><strong>면책 안내:</strong> 본 내용은 전통 명리학의 일반적 해석을 정리한 것이며, 의료·법률·재정·진로 결정의 근거가 될 수 없습니다. {currentYear}년 중요한 결정은 반드시 해당 분야 전문가와 상의하시기 바랍니다.</p>
    </section>

    <!-- 섹션 7: 건강 가이드 (오행 균형 + 계절별 주의) -->
    <section class="info-card">
      <h2>{zodiac.name}띠 건강 가이드</h2>
      <p>{zodiac.name}띠는 <strong>{zodiac.element}</strong> 속성에 해당합니다. 전통 명리학에서는 오행의 균형이 깨질 때 특정 장기가 약해진다고 봅니다. {zodiac.element === "수(水)" ? "수(水)가 과하면 신장·방광·순환계, 부족하면 허리·관절이 예민해질 수 있습니다. 따뜻한 음식과 충분한 수분 섭취로 균형을 잡는 것이 좋습니다." : ""}{zodiac.element === "토(土)" ? "토(土)가 과하면 위장·소화기·비장, 부족하면 피부·입술이 건조해질 수 있습니다. 규칙적인 식사 시간과 채식 위주 식단이 도움됩니다." : ""}{zodiac.element === "목(木)" ? "목(木)이 과하면 간장·담낭·눈, 부족하면 근육·긴장감이 예민해질 수 있습니다. 충분한 수면과 스트레칭으로 풀어주는 것이 좋습니다." : ""}{zodiac.element === "화(火)" ? "화(火)가 과하면 심장·혈관·혈압, 부족하면 손발 차가움·냉증이 나타날 수 있습니다. 적당한 유산소 운동과 매운 음식·카페인 조절을 권합니다." : ""}{zodiac.element === "금(金)" ? "금(金)이 과하면 폐·호흡기·피부, 부족하면 면역력 저하·알레르기가 나타날 수 있습니다. 마스크·손 세척과 환기, 비타민 C 섭취가 도움됩니다." : ""}</p>
      <p>계절별로 보면, {zodiac.name}띠는 {zodiac.element === "수(水)" ? "겨울(수旺)·여름(수衰)의 기운에 민감합니다. 겨울엔 보온에 신경 쓰고, 여름엔 무리한 야외 활동을 자제하세요." : ""}{zodiac.element === "토(土)" ? "환절기(토왕, 계절 전환기)에 컨디션 변동이 큽니다. 환절기 2주 전후로 충분한 휴식과 가벼운 운동을 병행하세요." : ""}{zodiac.element === "목(木)" ? "봄(목왕)에 기운이 왕성해져 활력이 넘치지만, 여름(목衰)에는 피로가 누적되기 쉽습니다. 봄엔 활동량을 늘리고 여름엔 충분한 휴식을 취하세요." : ""}{zodiac.element === "화(火)" ? "여름(화왕)에 에너지가 최고조지만, 겨울(화衰)엔 무기력이 올 수 있습니다. 여름엔 수분 보충, 겨울엔 따뜻한 차와 족욕이 도움됩니다." : ""}{zodiac.element === "금(金)" ? "가을(금왕)에 컨디션이 안정적이지만, 봄(금衰)엔 알레르기·호흡기 문제가 나타나기 쉽습니다. 봄엔 마스크·가글 습관을 들이세요." : ""} 추천 운동은 {zodiac.element === "수(水)" ? "수영·요가·필라테스 등 무리 없는 유산소" : ""}{zodiac.element === "토(土)" ? "걷기·하이킹·가벼웨이트 등 안정적 리듬 운동" : ""}{zodiac.element === "목(木)" ? "스트레칭·등산·조깅 등 신전성 운동" : ""}{zodiac.element === "화(火)" ? "달리기·자전거·에어로빅 등 활동적 유산소" : ""}{zodiac.element === "금(金)" ? "웨이트·필라테스·복싱 등 근력·코어 운동" : ""}입니다.</p>
    </section>

    <!-- 섹션 8: 재물·커리어 -->
    <section class="info-card">
      <h2>{zodiac.name}띠 재물·커리어 가이드</h2>
      <p>{zodiac.name}띠는 {zodiac.element} 속성답게 {zodiac.element === "수(水)" ? "지혜와 유연성으로 자산을 관리하는 타입입니다. 무리한 투자보다 안정적인 적금·채권·인덱스 펀드를 선호하며, 장기적 관점에서 복리 효과를 극대화합니다. 단, 유동성 자체를 좋아해 잦은 지출이 약점이므로 월 예산표 작성을 권합니다." : ""}{zodiac.element === "토(土)" ? "안정성과 신뢰를 바탕으로 꾸준히 자산을 쌓는 타입입니다. 부동산·예금·정기보험 등 안정 자산 비중을 높이는 것이 좋습니다. 보수적인 성격은 위기 시 손실을 줄여주지만, 인플레이션 대응에는 공격 자산 20~30% 혼합이 필요합니다." : ""}{zodiac.element === "목(木)" ? "성장과 발전을 추구해 위험 자산에도 도전하는 타입입니다. 주식·ETF·크립토 등 변동성 큰 자산에 관심이 많고, 장기 보유 시 복리 효과가 큽니다. 단, 한 분야에 몰빵하지 말고 분산 투자 원칙을 지키는 것이 핵심입니다." : ""}{zodiac.element === "화(火)" ? "열정과 추진력으로 단기간에 큰 수익을 추구하지만, 손실 회복도 빠른 타입입니다. 단타·단순 종목 매매보다 트렌드를 읽고 분할 매수하는 전략이 어울립니다. 충동적 결정을 막기 위해 매수 전 24시간 쿨다운 규칙을 두세요." : ""}{zodiac.element === "금(金)" ? "결단력과 정의감으로 재무 계획을 철저히 세우는 타입입니다. 절약·자산 배분·세금 최적화에 강점이 있고, 숫자에 강해 재무제표·세무 보고서 분석을 잘합니다. 보수적 자산 70% + 성장 자산 30% 비중이 안정적입니다." : ""}</p>
      <p>직업군 추천은 {zodiac.element === "수(水)" ? "연구원·컨설턴트·프로그래머·심리상담사 등 분석·지식 기반 직업" : ""}{zodiac.element === "토(土)" ? "공무원·회계사·부동산·농업·교육 등 안정성 기반 직업" : ""}{zodiac.element === "목(木)" ? "마케팅·기획·스타트업·교육·콘텐츠 크리에이터 등 성장 가능성 기반 직업" : ""}{zodiac.element === "화(火)" ? "영업·방송·스포츠·외식·이벤트 기획 등 사람과 활동 중심 직업" : ""}{zodiac.element === "금(金)" ? "법률·금융·의사·엔지니어·품질관리 등 정확성·전문성 기반 직업" : ""}입니다. 직장 내 {zodiac.name}띠는 {zodiac.element === "수(水)" ? "지적 호기심이 강해 새로운 프로젝트를 주도하기보다 깊이 파고드는 역할에 어울립니다." : ""}{zodiac.element === "토(土)" ? "책임감이 강해 팀의 중심을 잡고, 장기 프로젝트를 안정적으로 완수합니다." : ""}{zodiac.element === "목(木)" ? "아이디어가 풍부하고 협업을 좋아해 브레인스토밍·기획 단계에서 빛을 발합니다." : ""}{zodiac.element === "화(火)" ? "추진력과 카리스마로 팀 분위기를 띄우고, 마감 직전 추진력을 발휘합니다." : ""}{zodiac.element === "금(金)" ? "원칙과 기준을 중시해 품질 관리·리스크 관리·규정 준수 업무에 탁월합니다." : ""}</p>
    </section>

    <!-- 섹션 9: 연애·관계 심화 -->
    <section class="info-card">
      <h2>{zodiac.name}띠 연애·관계 심화 가이드</h2>
