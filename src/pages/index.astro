</style>

<script define:vars={{
  // 12개 띠의 모든 데이터를 JSON으로 직렬화해 inline 임베드 (~10KB)
  zodiacData: dailyFortune.zodiacs,
  zodiacMeta: ZODIACS.reduce<Record<string, { name: string; hanja: string; direction: string; color: string; luckyColor: string; luckyNumber: number; luckyDay: string; }>>((acc, z) => {
    acc[z.slug] = {
      name: z.name,
      hanja: z.hanja,
      direction: z.direction,
      color: z.elementColor,
      luckyColor: z.lucky.color,
      luckyNumber: z.lucky.number,
      luckyDay: z.lucky.day,
    };
    return acc;
  }, {}),
  todayDate: dailyFortune.date,
}}>
  // === Zodiac Interactive Picker ===
  // (a) 선택 띠를 localStorage에 저장, (b) 다음 방문 시 자동 복원
  // (c) 클릭 시 같은 자리(zodiac-result)에 점수/메시지 DOM 갱신

  const STORAGE_KEY = "fortune:selectedZodiac";

  /** 타입 안전 DOM 헬퍼 */
  function $(sel, root) {
    return (root || document).querySelector(sel);
  }
  function $$(sel, root) {
    return Array.from((root || document).querySelectorAll(sel));
  }

  const resultEl = $("#zodiac-result");
  if (!resultEl) {
    console.warn("zodiac-result not found");
  } else {
    const placeholderEl = $(".zodiac-result-placeholder", resultEl);
    const bodyEl = $(".zodiac-result-body", resultEl);
    const cards = $$(".js-pick-card");
    const resetBtn = $("#zodiac-reset");

    function setEmpty() {
      resultEl.classList.remove("filled");
      resultEl.classList.add("empty");
      resultEl.dataset.state = "empty";
      if (placeholderEl) placeholderEl.hidden = false;
      if (bodyEl) bodyEl.hidden = true;
      if (resetBtn) resetBtn.hidden = true;
      cards.forEach((c) => c.classList.remove("is-selected"));
      try { localStorage.removeItem(STORAGE_KEY); } catch {}
    }

    function setSelected(slug) {
      const data = zodiacData[slug];
      const meta = zodiacMeta[slug];
      if (!data || !meta) {
        console.warn("Unknown zodiac slug:", slug);
        return;
      }

      // 데이터 채우기
      const totalEl = $(".js-total", resultEl);
      const levelEl = $(".js-level", resultEl);
      const moneyEl = $(".js-money", resultEl);
      const loveEl = $(".js-love", resultEl);
      const healthEl = $(".js-health", resultEl);
      const workEl = $(".js-work", resultEl);
      const msgEl = $(".js-message", resultEl);
      const lColorEl = $(".js-lucky-color", resultEl);
      const lNumberEl = $(".js-lucky-number", resultEl);
      const lElementEl = $(".js-lucky-element", resultEl);
      const lDirectionEl = $(".js-lucky-direction", resultEl);

      const hanjaEl = $(".zodiac-result-hanja", resultEl);
      const nameEl = $(".zodiac-result-name", resultEl);
      const subEl = $(".zodiac-result-sub", resultEl);

      const scores = data.scores;
      if (totalEl) totalEl.textContent = String(scores.total);
      if (levelEl) levelEl.textContent = scores.level;
      if (moneyEl) moneyEl.textContent = String(scores.money);
      if (loveEl) loveEl.textContent = String(scores.love);
      if (healthEl) healthEl.textContent = String(scores.health);
      if (workEl) workEl.textContent = String(scores.work);
      if (msgEl) msgEl.textContent = data.message;
      if (lColorEl) lColorEl.textContent = meta.luckyColor;
      if (lNumberEl) lNumberEl.textContent = String(meta.luckyNumber);
      if (lElementEl) lElementEl.textContent = data.element;
      if (lDirectionEl) lDirectionEl.textContent = meta.direction;
      if (hanjaEl) hanjaEl.textContent = meta.hanja;
      if (nameEl) nameEl.textContent = meta.name;
      if (subEl) subEl.textContent = `${todayDate} 일진 · ${data.element} 오행`;

      // 상태 전환
      resultEl.classList.remove("empty");
      resultEl.classList.add("filled");
      resultEl.dataset.state = slug;
      if (placeholderEl) placeholderEl.hidden = true;
      if (bodyEl) bodyEl.hidden = false;
      if (resetBtn) resetBtn.hidden = false;

      // 카드 선택 표시
      cards.forEach((c) => {
        c.classList.toggle("is-selected", c.dataset.slug === slug);
      });

      // 저장
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify({ slug, ts: Date.now() })); } catch {}
      // URL도 업데이트 (공유/북마크 가능)
      try { history.replaceState(null, "", "?zodiac=" + encodeURIComponent(slug) + "#zodiac-result"); } catch {}
    }

    // 카드 클릭
    cards.forEach((card) => {
      card.addEventListener("click", () => {
        const slug = card.dataset.slug;
        if (slug) setSelected(slug);
      });
    });

    // 리셋
    if (resetBtn) {
      resetBtn.addEventListener("click", () => {
        setEmpty();
        // 결과 영역으로 스크롤하여 placeholder가 보이게 함
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        resultEl.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
      });
    }

    // 초기 복원: URL ?zodiac= 우선 → localStorage → placeholder
    function restoreInitial() {
      let slug = null;
      try {
        const url = new URL(window.location.href);
        const qSlug = url.searchParams.get("zodiac");
        if (qSlug && zodiacData[qSlug]) slug = qSlug;
        if (!slug) {
          const raw = localStorage.getItem(STORAGE_KEY);
          if (raw) {
            const parsed = JSON.parse(raw);
            if (parsed && typeof parsed.slug === "string" && zodiacData[parsed.slug]) {
              // 같은 날이면 복원, 다른 날이면 무시
              if (parsed.date === todayDate || !parsed.date) slug = parsed.slug;
            }
          }
        }
      } catch {}
      if (slug) setSelected(slug);
    }
    restoreInitial();
  }
</script>