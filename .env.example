# fortune-adsense — environment template
# Copy to .env and fill in real values. .env is gitignored.

# === Google AdSense ===
# Applied via https://www.google.com/adsense/  (한국: https://www.google.com/adsense/start/)
PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# === SNS syndication (used by cron: blog-sns-auto) ===
# Get these tokens BEFORE enabling the publish-side of blog-sns-auto.
# Without them, the cron correctly emits [SKIP] {SNS} token 없음 on every fire.
#
# Run `bash tools/setup-sns-tokens.sh` to check what is missing and to fill
# these in interactively. That script reports the state through the
# publisher's own loader, so its verdict always matches what will be used.
#
# An EMPTY value here does NOT disable a working credential stored in
# ~/.hermes/profiles/reviewer/.env -- a non-empty value always wins.

# X (Twitter) — https://developer.x.com/en/portal
# All four are required for a publish. X_API_KEY + X_API_SECRET are the
# OAuth2 consumer pair (also used for the free /2/usage/credits balance
# check); X_ACCESS_TOKEN + X_ACCESS_TOKEN_SECRET are the OAuth1 user context.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Threads — https://developers.facebook.com/docs/threads
# Long-lived access token. Required scope: threads_basic, threads_content_publish
THREADS_TOKEN=

# LinkedIn — https://www.linkedin.com/developers/
# OAuth2 access token with w_member_social scope. Refresh every 60 days.
LINKEDIN_TOKEN=

# dev.to — https://dev.to/settings/extensions
# API key from "DEV Community API Keys" section.
DEVTO_API_KEY=

# === Astro / build-time ===
PUBLIC_SITE_URL=https://fortune-adsense.example.com
